    {
      "name": "📋 Test User IDs (Save from Responses)",
      "item": [
        {
          "name": "Get User IDs for Testing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Save user IDs for testing\nif (pm.response.code === 200) {\n  var jsonData = pm.response.json();\n  \n  if (jsonData.data && jsonData.data.users && jsonData.data.users.length > 0) {\n    // Find superadmin\n    var superadmin = jsonData.data.users.find(u => u.role === 'superadmin');\n    if (superadmin) {\n      pm.collectionVariables.set('superadmin_id', superadmin._id);\n      console.log('✅ Superadmin ID saved: ' + superadmin._id);\n    }\n    \n    // Find regular user (not current user)\n    var regularUser = jsonData.data.users.find(u => u.role === 'user' && u.email !== 'john@example.com');\n    if (regularUser) {\n      pm.collectionVariables.set('user_id', regularUser._id);\n      console.log('✅ User ID saved: ' + regularUser._id);\n    }\n  }\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{superadmin_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/users",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "users"]
            },
            "description": "Get all users and save IDs for testing"
          },
          "response": []
        }
      ]
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Auto-save tokens based on role",
          "if (pm.response.code === 200) {\n  var jsonData = pm.response.json();\n  \n  if (jsonData.data && jsonData.data.token) {\n    var token = jsonData.data.token;\n    \n    // Get user role from response or decode token\n    var userRole = 'user';\n    \n    if (jsonData.data.user && jsonData.data.user.role) {\n      userRole = jsonData.data.user.role;\n    } else {\n      // Try to decode token\n      try {\n        var payload = JSON.parse(atob(token.split('.')[1]));\n        if (payload.role) userRole = payload.role;\n      } catch (e) {\n        console.log('Could not decode token');\n      }\n    }\n    \n    // Save token based on role\n    switch(userRole) {\n      case 'superadmin':\n        pm.collectionVariables.set('superadmin_token', token);\n        console.log('✅ Superadmin token saved');\n        break;\n      case 'admin':\n        pm.collectionVariables.set('admin_token', token);\n        console.log('✅ Admin token saved');\n        break;\n      default:\n        pm.collectionVariables.set('user_token', token);\n        pm.collectionVariables.set('auth_token', token); // Default\n        console.log('✅ User token saved');\n    }\n  }\n  \n  // Save reset token from forgot password\n  if (jsonData.data && jsonData.data.resetToken) {\n    pm.collectionVariables.set('reset_token', jsonData.data.resetToken);\n    console.log('✅ Reset token saved: ' + jsonData.data.resetToken);\n  }\n}",
          "",
          "// Basic response validation",
          "pm.test(\"Response has success field\", function () {\n  var jsonData = pm.response.json();\n  pm.expect(jsonData).to.have.property(\"success\");\n});",
          "",
          "pm.test(\"Response has timestamp\", function () {\n  var jsonData = pm.response.json();\n  pm.expect(jsonData).to.have.property(\"timestamp\");\n});",
          "",
          "// Role-based success tests\nif (pm.response.code === 403) {\n  pm.test(\"Access denied for insufficient permissions\", function() {\n    pm.expect(pm.response.code).to.equal(403);\n  });\n}"
        ]
      }
    },
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script to log what we're testing\nconsole.log('Testing: ' + pm.request.method + ' ' + pm.request.url);",
          "",
